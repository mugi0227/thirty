    "すべてのスキンのほか、ロック画面での表示や終了音も選べます。": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのスキンのほか、ロック画面での表示や終了音も選べます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock every skin, Lock Screen timers, and more end sounds."
          }
        }
      }
    },
    "とりあえず、30分！": {
      "extractionState": "manual",
